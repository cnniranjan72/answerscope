# Copy to .env and replace the placeholder tokens (>= 16 chars, different from each other).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
ANALYST_TOKEN=change-me-analyst-token-0000
ANALYST_NAME=analyst
REVIEWER_TOKEN=change-me-reviewer-token-0000
REVIEWER_NAME=reviewer

DATABASE_PATH=var/answerscope.db
# Extracted assignment pack (kept unchanged, outside version control)
PACK_DIR=assignment

# Default analysis provider: replay (keyless; recorded local-model outputs) | ollama (real local model) | stub (tests)
MODEL_PROVIDER=replay
REPLAY_DIR=replay
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# Execution bounds
MODEL_TIMEOUT_S=240
MODEL_MAX_ATTEMPTS=3
MODEL_MAX_OUTPUT_TOKENS=1200
MAX_INPUT_CHARS=20000
MAX_RESPONSES_PER_ANALYSIS=200
